{
  "name": "richtfest",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": ["richtfest-shared", "richtfest-os/apps/*", "richtfest-apps/*"],
  "scripts": {
    "dev": "bun run --filter @richtfest/api dev",
    "build": "bun run typecheck && bun run --filter @richtfest/web build && bun run --filter @richtfest/docs build",
    "build:web": "bun run --filter @richtfest/web build",
    "build:docs": "bun run --filter @richtfest/docs build",
    "start": "bun run --filter @richtfest/api start",
    "typecheck": "bun run --filter '@richtfest/*' typecheck",
    "test": "bun test",
    "db:migrate": "bun run --filter @richtfest/api db:migrate",
    "db:seed": "bun run --filter @richtfest/api db:seed",
    "backup": "./scripts/backup.sh",
    "restore": "./scripts/restore.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "railway": "^3.13.1",
    "typescript": "^5.7.2"
  }
}
