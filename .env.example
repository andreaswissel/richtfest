DATABASE_URL=postgresql://postgres:postgres@localhost:5432/richtfest
PORT=3000
# Optional server-side address autocomplete. Never expose this key in Vite variables.
GEOAPIFY_API_KEY=
# Enables one-click access to seeded @richtfest.local identities outside production.
# Production forces this off even if the variable is set.
ALLOW_DEV_AUTH=true
SESSION_COOKIE=richtfest_session
NODE_ENV=development
# Base64-encoded 32-byte key; required before saving AI credentials.
AI_CONNECTION_ENCRYPTION_KEY=
# Optional TypeSafe Jev server fallback; personal and workspace keys take precedence.
TYPESAFE_API_KEY=
# Experimental Jev image classification on new uploads and agent image questions.
# Opt-in only; sends source images to TypeSafe. Does not replace evidence review.
SOURCE_IMAGE_TRIAGE_ENABLED=false
# Local adapter for development and isolated tests. Production uses the private
# Railway Bucket contract below and does not use a volume-backed file path.
FILE_STORAGE_PATH=./.data/files
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=
# Inbound email (project forwarding addresses). Receiving domain configured in
# Resend (custom domain with MX record, or the account's <id>.resend.app) and the
# signing secret of the email.received webhook pointing at /api/inbound-email/resend.
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Railway Buckets (S3-compatible, private). Keep these values in Railway
# variables; do not commit them. The endpoint uses virtual-host style URLs.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=

# Optional Mastra supervisor. Keep false until migrations and model presets are configured.
AGENT_SUPERVISOR_ENABLED=false
# Curated public catalogue and scheduled Berlin imports. Enable after migration 0024
# and Railway Bucket configuration. Existing project imports remain the default.
PUBLIC_DATA_ENABLED=false
# Set provider-supported model IDs, or configure per-effort workspace presets in Settings.
# Without overrides, OpenAI uses Luna (low), Sol (medium), Astra (high/ultra).
# These role overrides, when set, apply across effort tiers.
OPENAI_SUPERVISOR_MODEL=
OPENAI_SPECIALIST_MODEL=
ANTHROPIC_SUPERVISOR_MODEL=
ANTHROPIC_SPECIALIST_MODEL=
# Optional Vercel AI Gateway adapter. Keep model IDs in provider/model form.
VERCEL_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_SUPERVISOR_MODEL=
VERCEL_SPECIALIST_MODEL=
