ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Asymmetric 2 x 3 x 4 metre box; millimetres; rotated placement'),'2;1');
FILE_NAME('location-ifc-mm.ifc','2026-10-10T00:00:00',('Richtfest'),('Richtfest'),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0AAAAAAAAAAAAAAAAAAAAA',$,'Regression box',$,$,$,$,(#10),#11);
#2=IFCCARTESIANPOINT((0.,0.,0.));
#3=IFCDIRECTION((0.,0.,1.));
#4=IFCDIRECTION((1.,0.,0.));
#5=IFCAXIS2PLACEMENT3D(#2,#3,#4);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#5,$);
#11=IFCUNITASSIGNMENT((#12));
#12=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#20=IFCCARTESIANPOINT((100000.,200000.,5000.));
#21=IFCDIRECTION((0.,1.,0.));
#22=IFCAXIS2PLACEMENT3D(#20,#3,#21);
#23=IFCLOCALPLACEMENT($,#22);
#30=IFCCARTESIANPOINT((0.,0.));
#31=IFCAXIS2PLACEMENT2D(#30,$);
#32=IFCRECTANGLEPROFILEDEF(.AREA.,$,#31,2000.,3000.);
#33=IFCEXTRUDEDAREASOLID(#32,#5,#3,4000.);
#34=IFCSHAPEREPRESENTATION(#10,'Body','SweptSolid',(#33));
#35=IFCPRODUCTDEFINITIONSHAPE($,$,(#34));
#36=IFCBUILDINGELEMENTPROXY('1AAAAAAAAAAAAAAAAAAAAA',$,'Box',$,$,#23,#35,$,.NOTDEFINED.);
ENDSEC;
END-ISO-10303-21;
