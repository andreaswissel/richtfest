ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('building-model.ifc','',(),(),'test','test','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('project',$,'Project',$,$,$,$,(#6),#4);
#2=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#4=IFCUNITASSIGNMENT((#2));
#5=IFCAXIS2PLACEMENT3D(#7,$,$);
#6=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.00001,#5,$);
#7=IFCCARTESIANPOINT((0.,0.,0.));
#8=IFCDIRECTION((0.,0.,1.));
#9=IFCDIRECTION((0.,1.,0.));
#10=IFCBUILDING('building',$,'Building',$,$,#14,$,$,.ELEMENT.,$,$,$);
#11=IFCCARTESIANPOINT((10000.,20000.,0.));
#12=IFCAXIS2PLACEMENT3D(#11,#8,#9);
#14=IFCLOCALPLACEMENT($,#12);
#20=IFCBUILDINGSTOREY('level',$,'First floor',$,$,#24,$,$,.ELEMENT.,3000.);
#21=IFCCARTESIANPOINT((1000.,2000.,3000.));
#22=IFCAXIS2PLACEMENT3D(#21,$,$);
#24=IFCLOCALPLACEMENT(#14,#22);
#25=IFCBUILDINGSTOREY('site',$,'Site plan',$,$,$,$,$,.ELEMENT.,12000.);
#30=IFCSPACE('room',$,'Room with shaft',$,$,#34,#55,'Room',.ELEMENT.,.INTERNAL.,$);
#31=IFCCARTESIANPOINT((500.,600.,0.));
#32=IFCAXIS2PLACEMENT3D(#31,$,$);
#34=IFCLOCALPLACEMENT(#24,#32);
#40=IFCCARTESIANPOINT((-2000.,-1000.));
#41=IFCCARTESIANPOINT((2000.,-1000.));
#42=IFCCARTESIANPOINT((2000.,1000.));
#43=IFCCARTESIANPOINT((-2000.,1000.));
#44=IFCPOLYLINE((#40,#41,#42,#43,#40));
#45=IFCCARTESIANPOINT((-500.,-250.));
#46=IFCCARTESIANPOINT((500.,-250.));
#47=IFCCARTESIANPOINT((500.,250.));
#48=IFCCARTESIANPOINT((-500.,250.));
#49=IFCPOLYLINE((#45,#46,#47,#48,#45));
#50=IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA.,$,#44,(#49));
#51=IFCEXTRUDEDAREASOLID(#50,#5,#8,2800.);
#53=IFCSHAPEREPRESENTATION(#6,'Body','SweptSolid',(#51));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#53));
#60=IFCWALL('wall',$,'Composite wall',$,$,#34,$,$,.NOTDEFINED.);
#61=IFCBUILDINGELEMENTPART('part',$,'Wall part',$,$,#34,#55,$,.NOTDEFINED.);
#70=IFCRELAGGREGATES('project-building',$,$,$,#1,(#10));
#71=IFCRELAGGREGATES('building-storeys',$,$,$,#10,(#20,#25));
#72=IFCRELAGGREGATES('storey-spaces',$,$,$,#20,(#30));
#73=IFCRELCONTAINEDINSPATIALSTRUCTURE('storey-wall',$,$,$,(#60),#20);
#74=IFCRELAGGREGATES('wall-parts',$,$,$,#60,(#61));
ENDSEC;
END-ISO-10303-21;
